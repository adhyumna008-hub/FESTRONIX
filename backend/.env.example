NODE_ENV=development
HOST=127.0.0.1
PORT=4300
# Runtime account: no DDL and no UPDATE/DELETE/TRUNCATE on audit logs.
DATABASE_URL=postgresql://festronix_app:local_only_change_me@127.0.0.1:55432/festronix_dev
# Separate migration/administration account. Never use it as the runtime account.
MIGRATION_DATABASE_URL=postgresql://postgres:local_only_change_me@127.0.0.1:55432/festronix_dev
RUNTIME_DATABASE_ROLE=festronix_app
# Use verified TLS on a remote database, with your trusted CA in PGSSLROOTCERT.
DATABASE_SSL=false
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# Prefer workload identity / Application Default Credentials in production.
# GOOGLE_APPLICATION_CREDENTIALS=absolute-path-to-private-service-account-json
# Optional Firebase Auth emulator, local development only:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Private development proof storage. Production requires reviewed durable storage (see BACKEND_SETUP.md).
PROOF_STORAGE=local
PROOF_DIRECTORY=.local/proofs
# Production local adapter requires a durable private absolute directory and explicit approval.
# Alternatively implement the ProofStore interface for your selected object store.
ALLOW_PRIVATE_LOCAL_PROOFS=false
